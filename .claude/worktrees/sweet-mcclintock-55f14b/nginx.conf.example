# ── Configuration Nginx pour Culture Mashup Quiz ──────────────────────────
# Remplace "quiz.tondomaine.com" par ton vrai domaine
# Copie ce fichier dans /etc/nginx/sites-available/quiz
# Puis : sudo ln -s /etc/nginx/sites-available/quiz /etc/nginx/sites-enabled/
# Puis : sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name quiz.tondomaine.com;

    # Taille max upload (vidéos, images, audio)
    client_max_body_size 500M;

    # Proxy vers le serveur Node.js
    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;

        # WebSocket (Socket.io)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;
    }
}

# ── Avec HTTPS (Let's Encrypt) ─────────────────────────────────────────────
# Après avoir configuré le bloc ci-dessus, lance :
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d quiz.tondomaine.com
# Certbot modifie automatiquement ce fichier pour ajouter HTTPS
